{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "RequestHelpResult",
  "type": "object",
  "required": [
    "outcome",
    "tab_id"
  ],
  "properties": {
    "completed_by": {
      "anyOf": [
        {
          "$ref": "#/definitions/HelpCompletedBy"
        },
        {
          "type": "null"
        }
      ]
    },
    "note": {
      "type": [
        "string",
        "null"
      ]
    },
    "outcome": {
      "$ref": "#/definitions/HelpOutcome"
    },
    "resolved_targets": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "$ref": "#/definitions/ResolvedTarget"
      }
    },
    "tab_id": {
      "type": "integer",
      "format": "int64"
    },
    "goal_verified": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "state_diff": {
      "anyOf": [
        {
          "$ref": "#/definitions/HelpStateDiff"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "definitions": {
    "HelpCompletedBy": {
      "type": "string",
      "enum": [
        "system"
      ]
    },
    "HelpOutcome": {
      "oneOf": [
        {
          "description": "User completed the step and clicked Done / return control.",
          "type": "string",
          "enum": [
            "continued"
          ]
        },
        {
          "description": "User declined / aborted via the overlay's Cancel button.",
          "type": "string",
          "enum": [
            "cancelled"
          ]
        },
        {
          "description": "The wait expired before the user acted.",
          "type": "string",
          "enum": [
            "timed_out"
          ]
        },
        {
          "description": "Explicit success criteria matched while the user had control.",
          "type": "string",
          "enum": [
            "completed"
          ]
        },
        {
          "description": "The page navigated while waiting (full reload or SPA URL change). Deprecated: navigation alone should not end a help request.",
          "type": "string",
          "enum": [
            "navigated"
          ]
        },
        {
          "description": "request-help is disabled by configuration (`BSK_REQUEST_HELP=off`): the call returns immediately without ever showing the overlay.",
          "type": "string",
          "enum": [
            "disabled"
          ]
        }
      ]
    },
    "ResolvedTarget": {
      "description": "Per-target resolution status echoed back so the agent can tell which `ref` / `selector` actually matched a live element.",
      "type": "object",
      "required": [
        "matched"
      ],
      "properties": {
        "matched": {
          "type": "boolean"
        },
        "ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "selector": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "HelpIndicators": {
      "type": "object",
      "required": ["login", "upload", "success"],
      "properties": {
        "login": { "type": "boolean" },
        "upload": { "type": "boolean" },
        "success": { "type": "boolean" }
      }
    },
    "HelpTabSummary": {
      "type": "object",
      "required": ["id", "active"],
      "properties": {
        "id": { "type": "integer", "format": "int64" },
        "url": { "type": ["string", "null"] },
        "active": { "type": "boolean" }
      }
    },
    "HelpCheckpointSummary": {
      "type": "object",
      "required": ["url", "tabs", "dom_signature", "accessibility_signature", "indicators"],
      "properties": {
        "url": { "type": "string" },
        "tabs": { "type": "array", "items": { "$ref": "#/definitions/HelpTabSummary" } },
        "dom_signature": { "type": "string" },
        "accessibility_signature": { "type": "string" },
        "indicators": { "$ref": "#/definitions/HelpIndicators" }
      }
    },
    "HelpStateDiff": {
      "type": "object",
      "required": ["changed", "url_changed", "tabs_changed", "dom_changed", "accessibility_changed", "indicators_changed"],
      "properties": {
        "changed": { "type": "array", "items": { "type": "string" } },
        "url_changed": { "type": "boolean" },
        "tabs_changed": { "type": "boolean" },
        "dom_changed": { "type": "boolean" },
        "accessibility_changed": { "type": "boolean" },
        "indicators_changed": { "type": "boolean" },
        "before": { "anyOf": [{ "$ref": "#/definitions/HelpCheckpointSummary" }, { "type": "null" }] },
        "after": { "anyOf": [{ "$ref": "#/definitions/HelpCheckpointSummary" }, { "type": "null" }] }
      }
    }
  }
}
