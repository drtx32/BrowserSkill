{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SnapshotResult",
  "type": "object",
  "required": [
    "ref_count",
    "tab_id",
    "text"
  ],
  "properties": {
    "canonical_diagnostic": {
      "description": "Opt-in diagnostic describing why the canonical projection was absent.",
      "anyOf": [
        {
          "$ref": "#/definitions/CanonicalDiagnostic"
        },
        {
          "type": "null"
        }
      ]
    },
    "canonical_scope": {
      "anyOf": [
        {
          "$ref": "#/definitions/CanonicalScope"
        },
        {
          "type": "null"
        }
      ]
    },
    "dialogs": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/JavaScriptDialogInfo"
      }
    },
    "fields": {
      "description": "Canonical semantic projection for refs in this snapshot.",
      "type": "array",
      "items": {
        "$ref": "#/definitions/SnapshotField"
      }
    },
    "ref_count": {
      "description": "Number of `@e<N>` refs registered for this session by this snapshot. Equivalent to the size of the new ref-store map.",
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "revision": {
      "description": "Revision of the canonical projection, when available.",
      "type": [
        "string",
        "null"
      ]
    },
    "tab_id": {
      "description": "Tab the snapshot was actually computed for (after resolving the optional `tab_id` default).",
      "type": "integer",
      "format": "int64"
    },
    "text": {
      "description": "Indented aria-snapshot text. Refs are rendered as `@e<N>` so the agent can copy them into subsequent `tool.click` / `tool.fill` selectors.",
      "type": "string"
    },
    "truncated": {
      "description": "Whether the rendered tree was truncated because of `max_depth` / `max_tokens`. Agents may re-run with looser caps.",
      "default": false,
      "type": "boolean"
    }
  },
  "definitions": {
    "CanonicalDiagnostic": {
      "type": "object",
      "required": [
        "falsyInputs",
        "fieldCount",
        "hasCanonical",
        "refCount",
        "revisionKind",
        "tabIdKind"
      ],
      "properties": {
        "documentId": {
          "type": [
            "string",
            "null"
          ]
        },
        "falsyInputs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "fieldCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "hasCanonical": {
          "type": "boolean"
        },
        "origin": {
          "type": [
            "string",
            "null"
          ]
        },
        "refCount": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "revisionKind": {
          "type": "string"
        },
        "tabIdKind": {
          "type": "string"
        },
        "trigger": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "CanonicalScope": {
      "type": "object",
      "required": [
        "document_id",
        "origin"
      ],
      "properties": {
        "document_id": {
          "type": "string"
        },
        "origin": {
          "type": "string"
        }
      }
    },
    "JavaScriptDialogHandledAction": {
      "description": "How the extension resolved the dialog so CDP could continue.",
      "type": "string",
      "enum": [
        "accepted",
        "dismissed"
      ]
    },
    "JavaScriptDialogInfo": {
      "description": "One observed + handled JavaScript dialog during a tool call.",
      "type": "object",
      "required": [
        "handled",
        "message",
        "sequence",
        "tab_id",
        "type"
      ],
      "properties": {
        "default_prompt": {
          "type": [
            "string",
            "null"
          ]
        },
        "handled": {
          "$ref": "#/definitions/JavaScriptDialogHandledAction"
        },
        "has_browser_handler": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "message": {
          "type": "string"
        },
        "sequence": {
          "description": "Monotonic per-tab sequence for ordering within a session.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "tab_id": {
          "type": "integer",
          "format": "int64"
        },
        "type": {
          "$ref": "#/definitions/JavaScriptDialogType"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "JavaScriptDialogType": {
      "description": "Native JS dialog kind reported by CDP.",
      "type": "string",
      "enum": [
        "alert",
        "confirm",
        "prompt",
        "beforeunload"
      ]
    },
    "SnapshotField": {
      "type": "object",
      "required": [
        "target"
      ],
      "properties": {
        "address": {
          "type": [
            "string",
            "null"
          ]
        },
        "ambiguous": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "binding": {
          "type": [
            "string",
            "null"
          ]
        },
        "revision": {
          "type": [
            "string",
            "null"
          ]
        },
        "target": {
          "type": "string"
        },
        "target_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
