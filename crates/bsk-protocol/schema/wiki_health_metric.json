{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HealthMetric",
  "type": "object",
  "required": [
    "denominator",
    "evidence_revision",
    "formula",
    "numerator",
    "rate",
    "sample_ids"
  ],
  "properties": {
    "denominator": {
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    },
    "evidence_revision": {
      "type": "integer",
      "format": "uint64",
      "minimum": 0.0
    },
    "formula": {
      "type": "string"
    },
    "numerator": {
      "type": "integer",
      "format": "uint",
      "minimum": 0.0
    },
    "rate": {
      "type": "number",
      "format": "double"
    },
    "sample_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
